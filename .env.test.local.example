# E2E testleri (npm run test:e2e) için — kopyala .env.test.local olarak doldur.
# Bu bilerek .env.local'daki üretim değişkenlerinden ayrı bir isim alanı kullanır;
# hiçbir şekilde production Supabase projesine karşı ÇALIŞTIRMA.

# Ayrı/izole bir test Supabase projesinin bilgileri (supabase.com -> New project)
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=

# globalSetup offers/leads/vehicles tablolarını temizler. Yalnız ayrı ve
# atılabilir proje olduğunu bağımsız doğruladıktan sonra true yap.
E2E_ALLOW_DESTRUCTIVE_CLEANUP=false

# O test projesinde Authentication -> Users -> Add user ile
# "Auto Confirm User" işaretli oluşturulmuş bir test kullanıcısı
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
