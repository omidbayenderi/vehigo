NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SCANNER_INGEST_SECRET=change-me
DELIVERY_RECEIPT_HMAC_SECRET=change-me-with-at-least-32-characters
DELIVERY_RECEIPT_RETENTION_DAYS=90
DELIVERY_RECEIPT_CLAIM_MINUTES=15
CRON_SECRET=change-me-too
TELEGRAM_BOT_TOKEN=123456:replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=change-me

BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# transient_search processes results only in memory; persistent_search requires contractual storage rights.
BRAVE_SEARCH_MODE=transient_search
# Set true only when the selected Brave plan/contract explicitly permits storing results.
BRAVE_SEARCH_STORAGE_RIGHTS_CONFIRMED=false

# Apify is an optional connector runtime. Persistence stays off unless both
# this switch and active provider_storage_rights_evidence exist per source.
APIFY_ENABLED=false
APIFY_API_TOKEN=your-apify-api-token
APIFY_MOBILE_DE_ACTOR=memo23/mobile-de-scraper
APIFY_AUTOSCOUT24_ACTOR=blackfalcondata/autoscout24-scraper
APIFY_MARKTPLAATS_ACTOR=memo23/marktplaats-nl-scraper
APIFY_MAX_RESULTS_PER_RUN=50
APIFY_PERSIST_RESULTS=false
OPENAI_API_KEY=your-openai-api-key
OPENAI_ARBITRAGE_MODEL=gpt-5.6-luna
OPENAI_MARKET_MODEL=replace-with-supported-market-model
OPENAI_DAMAGE_MODEL=replace-with-supported-vision-model
OPENAI_MONTHLY_BUDGET_USD=10
OPENAI_INPUT_USD_PER_MILLION=replace-with-verified-price
OPENAI_OUTPUT_USD_PER_MILLION=replace-with-verified-price

TELEGRAM_CRITERIA_CHANNEL=@Vehigo_Kriter
TELEGRAM_OPPORTUNITY_CHANNEL=@Vehigo_Firsat
TELEGRAM_ARBITRAGE_CHANNEL=@Vehigo_Arbitraj
